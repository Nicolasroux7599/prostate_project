## installation des différents pasckages
# install.packages("randomForest")
library(randomForest) ## Random Forest
library(MASS)
set.seed(123)
### Question 1
data("Boston")
str(Boston)
Boston_melange = Boston[sample(1:nrow(Boston)), ]
train = Boston_melange[1:300,]
test = Boston_melange[301:506,]
## Question 2
rf_boston = randomForest(medv~., data = train)
pred = predict(rf_boston, newdata = test)
head(data.frame(data = test$medv, perd = pred))
rmse = sqrt(mean((pred - test$medv)^2)) # RMSE = Root Mean Squared Error
rmse
rf_boston
sqrt(11.6306)
results
## Question 3
# mtry possibles (<= 13 prédicteurs)
l = c(2, 4, 6, 8, 10, 12)
results = data.frame(mtry = l, RMSE = NA)
for (i in 1:6) {
rf = randomForest(medv~., data = train, mtry = l[i])
pred = predict(rf, newdata = test)
rmse = sqrt(mean((pred - test$medv)^2)) # RMSE = Root Mean Squared Error
results$RMSE[i] = rmse
}
results
## Question 4
rf_boston_bis = randomForest(medv ~ ., data = train, importance = TRUE)
imp_b = importance(rf_boston_bis)
print(imp_b)
# Arbre unique
tree_boston =  randomForest(medv ~ ., data = train, ntree = 1)
pred_tree_b = predict(tree_boston, newdata = test)
rmse_tree = sqrt(mean((pred_tree_b - test$medv)^2))
r2_tree = 1 - sum((pred_tree_b - test$medv)^2) / sum((test$medv - mean(test$medv))^2)
# Random forest
pred_rf_b = predict(rf_boston, newdata = test)
rmse_rf = sqrt(mean((pred_rf_b - test$medv)^2))
r2_rf = 1 - sum((pred_rf_b - test$medv)^2) / sum((test$medv - mean(test$medv))^2)
list(tree_RMSE = rmse_tree, rf_RMSE = rmse_rf, tree_R2 = r2_tree, rf_R2 = r2_rf)
nb_iteration = 50
res = numeric(nb_iteration)
for (i in 1:nb_iteration){
Boston_melange = Boston[sample(1:nrow(Boston)), ]
train = Boston_melange[1:300,]
test = Boston_melange[301:506,]
rf = randomForest(medv~., data = train)
pred = predict(rf, newdata = test)
res[i] = sqrt(mean((pred - test$medv)^2))
}
summary(res)
hist(res, main="Distribution des RMSE (Boston) sur 50 runs", xlab="RMSE")
data(iris)
str(iris)
iris_melange = iris[sample(1:nrow(iris)),]
train = iris_melange[1:100,]
test = iris_melange[101:150,]
