boxplot(count ~ spray, data=InsectSprays)
library(MASS)
data(cabbages)
boxplot(HeadWt ~ Cult, data=cabbages)
# Observations : les choux du "cultivar" c39 semblent avoir un poids plus ?lev? que
# ceux du "cultivar" c52 mais comme il y a recouvrement entre les bo?tes de
# dispersion, il va falloir recourir au test statistique pour v?rifier si cette
# diff?rence est significative.
boxplot(HeadWt ~ Date, data=cabbages)
# Observations : La date de plantation n'a pas un effet clair sur le poids. Les boites
# de dispersion se recouvrent, il est difficile de se prononcer sans un recours au
# test.
boxplot(HeadWt ~ Date + Cult, data=cabbages)
boxplot(VitC ~ Cult, data=cabbages)
# Observations : le "cultivar" c52 semble avoir le taux de vitamines C le plus ?lev?.
# A v?rifier par les tests.
boxplot(VitC ~ Date, data=cabbages)
# Observations : la date de plantation n'a pas un effet clair sur le taux de vitamines
# C. Les boites de dispersion se recouvrent, il est difficile de se prononcer sans un
# recours au test.
boxplot(VitC ~ Date + Cult, data=cabbages)
myAOV = aov(HeadWt ~ Date + Cult + Date:Cult, data=cabbages)
summary(myAOV)
shapiro.test(residuals(myAOV))
bartlett.test(HeadWt ~ Cult, data=cabbages)
bartlett.test(HeadWt ~ Date, data=cabbages)
TukeyHSD(myAOV)
myAOV = aov(VitC ~ Date + Cult + Date:Cult, data=cabbages)
summary(myAOV)
shapiro.test(residuals(myAOV))
bartlett.test(VitC ~ Cult, data=cabbages)
bartlett.test(VitC ~ Date, data=cabbages)
TukeyHSD(myAOV)
