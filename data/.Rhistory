col = c("lightblue", "lightgreen"))
}
lda_model = lda(diabetes ~ ., data = df)
lda_model
plot(lda_model)
#  Réaliser une prédiction sur les données d’apprentissage.
lda_pred = predict(lda_model, df)
lda_pred$class
# Calculer la matrice de confusion et le taux de bonne classification.
conf_lda = table(df$diabetes, lda_pred$class)
conf_lda
taux_lda = sum(diag(conf_lda)) / sum(conf_lda)
taux_lda
# refaite les 3 premier point en utilisant 200 observations de la base de donnée afin de créer votre modèle , et utiliser le reste des données afin de claculer le taux de bonne classification.
set.seed(123)
df_melange = df[sample(1:nrow(df)), ]
head(df_melange)
lda_200 = lda(diabetes ~ ., data = df_melange[1:200,])
lda_predict_200 = predict(lda_200, df_melange[201:768,])
conf_lda_200 <- table(df_melange[201:768,]$diabetes, lda_predict_200 $class)
conf_lda_200
taux_lda_200 <- sum(diag(conf_lda_200)) / sum(conf_lda_200)
taux_lda_200
# Construire le modèle LDA
modele_lda_2D <- lda(diabetes ~ glucose + mass, data = df)
# Créer une grille de points couvrant le plan (glucose, mass)
glucose_range <- seq(min(df$glucose), max(df$glucose), length.out = 200)
mass_range <- seq(min(df$mass), max(df$mass), length.out = 200)
grille <- expand.grid(glucose = glucose_range, mass = mass_range)
# Prédire la classe sur la grille
pred <- predict(modele_lda_2D, newdata = grille)
grille$classe <- pred$class
# Tracer le nuage de points et les frontières de décision
ggplot() +
geom_tile(data = grille, aes(x = glucose, y = mass, fill = classe), alpha = 0.3) +
geom_point(data = df, aes(x = glucose, y = mass, color = diabetes), size = 2) +
scale_fill_manual(values = c("skyblue", "salmon")) +
scale_color_manual(values = c("blue", "red")) +
labs(title = "Frontières de décision LDA (glucose vs mass)",
x = "Glucose",
y = "Masse corporelle (BMI)") +
theme_minimal()
# Utiliser la fonction qda() du package MASS pour construire un modèle QDA.
qda_model = qda(diabetes ~ ., data = df)
qda_model
#  Réaliser une prédiction et comparer les résultats avec ceux du modèle LDA.
qda_pred = predict(qda_model, df)
qda_pred$class
# Comparaison LDA vs QDA
table(LDA = lda_pred$class, QDA = qda_pred$class)
# Calculer la matrice de confusion et le taux de bonne classification.
conf_qda = table(df$diabetes, qda_pred$class)
conf_qda
taux_qda = sum(diag(conf_qda)) / sum(conf_qda)
taux_qda
head(df_melange)
qda_200 = qda(diabetes ~ ., data = df_melange[1:200,])
qda_predict_200 = predict(qda_200, df_melange[201:768,])
