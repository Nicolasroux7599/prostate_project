tree_iris =  randomForest(Species ~ ., data = train, ntree = 1)
pred_tree = predict(tree_iris, newdata = test)
acc_tree = mean(pred_tree == test$Species)
# Random forest
pred_rf <- predict(rf_iris, newdata = test)
acc_rf <- mean(pred_rf == test$Species)
# Confusion matrices
conf_tree <- table(Pred = pred_tree, True = test$Species)
conf_rf   <- table(Pred = pred_rf,   True = test$Species)
list(tree_acc = acc_tree, rf_acc = acc_rf, conf_tree = conf_tree, conf_rf = conf_rf)
nb_iteration = 50
res = numeric(nb_iteration)
for (i in 1:nb_iteration){
iris_melange = iris[sample(1:nrow(iris)), ]
train = iris_melange[1:100,]
test = iris_melange[101:150,]
rf = randomForest(Species~., data = train)
pred = predict(rf, newdata = test)
res[i] = mean(pred == test$Species)
}
summary(res)
hist(res, main="Distribution des accuracies (iris) sur 50 runs", xlab="Accuracy")
data(PlantGrowth)
str(PlantGrowth)
boxplot(weight ~ group, data=PlantGrowth)
myAOV = aov(weight ~ group, data=PlantGrowth)
summary(myAOV)
hist(residuals(myAOV))
qqnorm(residuals(myAOV))
qqline(residuals(myAOV))
shapiro.test(residuals(myAOV))
bartlett.test(weight ~ group, data=PlantGrowth)
